.env
.env.*
*.pem
*.key

# ─────────────────────────────────────────────
# 대용량 원본 데이터 — GitHub 업로드 불가
# 682GB: WSI 원본 (normal/abnormal)
# ─────────────────────────────────────────────
dataset/wsi/
# 8.8GB: mitosis SVS
PreTox/mitosis_detection/wsi/
# 485MB
download_svs/*.svs

# 12GB: 추출 특징. wsi/ 에서 TRIDENT + CONCH v1.5 로 재생성 가능
dataset/features/20x_512px_0px_overlap/features_conch_v15/

# ─────────────────────────────────────────────
# 사내 저장소 (VIENCE-Inc) — 개인 저장소에 포함하지 않음
